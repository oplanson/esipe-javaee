<server description="API Gateway / BFF Server">

    <!-- Enable features -->
    <featureManager>
        <feature>webProfile-10.0</feature>
        <feature>microProfile-6.0</feature>
    </featureManager>

    <!-- HTTP Endpoint -->
    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${http.port}"
                  httpsPort="${https.port}"
                  host="*" />

    <!-- Web Application -->
    <webApplication id="api-gateway"
                    location="api-gateway.war"
                    contextRoot="/web">
        <classloader delegation="parentLast" />
    </webApplication>

    <!-- Root-level redirector to map /api/* -> /web/api/* as a temporary compatibility shim -->
    <webApplication id="root-redirect"
                    location="root-redirect-1.0.0.war"
                    contextRoot="/">
        <classloader delegation="parentLast" />
    </webApplication>

    <!-- Logging -->
    <logging traceSpecification="*=info:com.bank.*=fine" 
             maxFileSize="20" 
             maxFiles="10" />

    <!-- MicroProfile Config -->
    <mpMetrics authentication="false" />
</server>

