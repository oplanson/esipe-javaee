# Runtime image for Account Service microservice
# Expects the WAR file to be built locally before container build

FROM icr.io/appcafe/open-liberty:full-java17-openj9-ubi

# Copy Liberty configuration
COPY --chown=1001:0 src/main/liberty/config/server.xml /config/
COPY --chown=1001:0 src/main/liberty/config/bootstrap.properties /config/

# Copy PostgreSQL driver
ADD --chown=1001:0 https://jdbc.postgresql.org/download/postgresql-42.7.1.jar /opt/ol/wlp/usr/shared/resources/

# Copy the application WAR (built locally)
COPY --chown=1001:0 target/*.war /config/apps/

# Configure Liberty
RUN configure.sh

# Expose ports
EXPOSE 9082 9443

# Run Liberty
CMD ["/opt/ol/wlp/bin/server", "run", "defaultServer"]

# Made with Bob