<server description="Banking Application Server">

    <!-- Enable features -->
    <featureManager>
        <!-- Jakarta EE 10 Features -->
        <feature>servlet-6.0</feature>
        <feature>cdi-4.0</feature>
        <feature>jsonb-3.0</feature>
        <feature>jsonp-2.1</feature>
        
        <!-- MicroProfile 6.0 Features -->
        <feature>mpConfig-3.0</feature>
        <feature>mpHealth-4.0</feature>
        <feature>mpMetrics-5.0</feature>
        <feature>mpOpenAPI-3.1</feature>
    </featureManager>

    <!-- HTTP Endpoint -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}" />

    <!-- Web Application Configuration -->
    <!-- Explicit application declaration for educational purposes -->
    <webApplication id="banking-app"
                    location="banking-app.war"
                    contextRoot="${app.context.root}">
        <!-- Enable visibility of Jakarta EE APIs -->
        <classloader apiTypeVisibility="spec, ibm-api, third-party"/>
    </webApplication>

    <!-- Logging -->
    <logging traceSpecification="*=info" 
             maxFileSize="20" 
             maxFiles="10" />

    <!-- Application Manager -->
    <applicationManager autoExpand="true"/>

</server>

