<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Banking Hexagonal Architecture Application</display-name>
    <description>Lab 07 - Hexagonal Architecture (Ports and Adapters)</description>

    <!-- Welcome file list -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- CDI-managed servlets (NOT using @WebServlet for proper CDI injection) -->
    <servlet>
        <servlet-name>ClientWebAdapter</servlet-name>
        <servlet-class>com.bank.infrastructure.web.adapter.ClientWebAdapter</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>ClientWebAdapter</servlet-name>
        <url-pattern>/clients</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>ClientWebAdapter</servlet-name>
        <url-pattern>/clients/*</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>AccountWebAdapter</servlet-name>
        <servlet-class>com.bank.infrastructure.web.adapter.AccountWebAdapter</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AccountWebAdapter</servlet-name>
        <url-pattern>/accounts</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>AccountWebAdapter</servlet-name>
        <url-pattern>/accounts/*</url-pattern>
    </servlet-mapping>

    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error-404.html</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error-500.html</location>
    </error-page>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

</web-app>

