<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    
    <persistence-unit name="bankingPU" transaction-type="JTA">
        <jta-data-source>jdbc/bankingDS</jta-data-source>
        
        <!-- JPA Entities (Infrastructure Layer) -->
        <class>com.bank.infrastructure.persistence.entity.ClientEntity</class>
        <class>com.bank.infrastructure.persistence.entity.AccountEntity</class>
        
        <properties>
            <!-- Hibernate properties -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            
            <!-- Schema management - Flyway handles migrations -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            
            <!-- Performance -->
            <property name="hibernate.jdbc.batch_size" value="20"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>
        </properties>
    </persistence-unit>
</persistence>

