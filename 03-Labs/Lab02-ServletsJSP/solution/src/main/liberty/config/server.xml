<?xml version="1.0" encoding="UTF-8"?>
<server description="Banking Application Server - Lab 02">

    <!-- Enable features -->
    <featureManager>
        <!-- Jakarta EE Features -->
        <feature>servlet-6.0</feature>
        <feature>pages-3.1</feature>
        <feature>cdi-4.0</feature>
        <feature>jsonb-3.0</feature>
        
        <!-- MicroProfile Features -->
        <feature>mpConfig-3.0</feature>
        <feature>mpHealth-4.0</feature>
        <feature>mpMetrics-5.0</feature>
    </featureManager>

    <!-- HTTP Endpoint -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${http.port}"
                  httpsPort="${https.port}" />

    <!-- Web Application -->
    <webApplication id="banking-web-app" 
                    location="banking-web-app.war" 
                    contextRoot="/">
        <!-- Enable CDI -->
        <classloader apiTypeVisibility="+third-party"/>
    </webApplication>

    <!-- Logging -->
    <logging traceSpecification="*=info:com.bank.*=all" 
             maxFileSize="20" 
             maxFiles="10" />

    <!-- Application Security (basic for now) -->
    <applicationManager autoExpand="true"/>

</server>

