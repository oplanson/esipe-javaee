<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Banking Web Application</display-name>
    <description>Lab 02: Servlets, JSP and MicroProfile with Filters and Listeners</description>

    <!-- Context parameters for application configuration -->
    <context-param>
        <param-name>app.name</param-name>
        <param-value>Banking Application</param-value>
    </context-param>
    
    <context-param>
        <param-name>web.pagination.default.size</param-name>
        <param-value>10</param-value>
    </context-param>
    
    <context-param>
        <param-name>feature.client.deletion.enabled</param-name>
        <param-value>true</param-value>
    </context-param>

    <!--
    ========================================
    FILTERS CONFIGURATION
    ========================================
    Filters are configured using @WebFilter annotations in the code.
    The following filters are available:
    
    1. AuthenticationFilter - Protects URLs requiring authentication
       - URL Pattern: /*
       - Protects: /clients/*, /admin/*
       - Public: /login, /logout, /public/*, /css/*, /js/*, /images/*
    
    2. LoggingFilter - Logs all HTTP requests and responses with timing
       - URL Pattern: /*
       - Logs: Method, URI, parameters, status code, execution time
    
    3. CorsFilter - Handles CORS for REST API endpoints
       - URL Pattern: /api/*
       - Allowed Origins: localhost:3000, localhost:4200, localhost:8080
       - Allowed Methods: GET, POST, PUT, DELETE, OPTIONS, HEAD
    
    4. CompressionFilter - Compresses responses using GZIP
       - URL Pattern: /*
       - Compresses: text/html, text/css, application/javascript, etc.
       - Minimum size: 1KB
    
    Note: Filters are executed in the order they are loaded by the container.
    To control filter order, use web.xml <filter-mapping> with <dispatcher> elements.
    -->

    <!--
    ========================================
    LISTENERS CONFIGURATION
    ========================================
    Listeners are configured using @WebListener annotations in the code.
    The following listeners are available:
    
    1. ApplicationLifecycleListener - Monitors application startup/shutdown
       - Logs application lifecycle events
       - Initializes/cleans up resources
       - Tracks application uptime
    
    2. SessionCounterListener - Tracks active user sessions
       - Counts active sessions
       - Logs session creation/destruction
       - Tracks user login/logout
       - Stores statistics in ServletContext
    -->

    <!-- Welcome file list -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error-404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error-500.jsp</location>
    </error-page>

</web-app>

